; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project: Farmer"
run/main_scene="uid://bbvhog32snru6"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlantDatabase="*res://Scripts/plant_database.gd"
GameData="*res://Scripts/game_data.gd"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"
Watcher="*res://watcher.gd"
PlayerData="*res://player/player_data.gd"
TimeManager="*res://time_manager.gd"
SceneTransition="*res://ui/scene_transition.tscn"
QuestManager="*res://quest_system/quest_manager.gd"
SignalBus="*res://quest_system/signal_bus.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"NPC_Frujt": "res://Dialog/NPC_Frujt.dch",
"NPC_Jack": "res://Dialog/NPC_Jack.dch",
"player": "res://Dialog/player/player.dch",
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={
"SellingFrujt": "res://Dialog/timeline/SellingFrujt.dtl",
"timeline_npc_jack": "res://Dialog/timeline_npc_jack.dtl",
"timeline_stinky": "res://Dialog/timeline/timeline_stinky.dtl",
"welcome_home_jack": "res://Dialog/timeline/welcome_home_john.dtl"
}
layout/style_directory={
"": "res://Dialog/styles/New_File.tres",
"Normal": "res://Dialog/styles/New_File.tres"
}
layout/style_list=["res://Dialog/styles/New_File.tres"]
layout/default_style="res://Dialog/styles/New_File.tres"
glossary/default_case_sensitive=true
variables={
"stink_line_eng": ""
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

external_inventory=""
smooth=""
inventory_interface=""
Player=""
coop_ui=""

